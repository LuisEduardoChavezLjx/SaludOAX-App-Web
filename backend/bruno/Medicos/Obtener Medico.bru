meta {
  name: Obtener Medico
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/medicos/1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenPaciente}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("trae nombre del medico", function() {
    expect(res.body.nombre).to.be.a("string");
  });
}
