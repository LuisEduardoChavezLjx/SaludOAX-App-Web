meta {
  name: 401 - Credenciales Invalidas
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@saludoax.com",
    "password": "contrasena_incorrecta"
  }
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
  test("mensaje de credenciales invalidas", function() {
    expect(res.body.mensaje).to.equal("Credenciales invalidas");
  });
}
