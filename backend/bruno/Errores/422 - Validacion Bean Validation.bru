meta {
  name: 422 - Validacion Bean Validation
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "test999@correo.com",
    "password": "simple",
    "nombre": "Test",
    "rol": "PACIENTE"
  }
}

tests {
  test("status is 422", function() {
    expect(res.getStatus()).to.equal(422);
  });
  test("detalle marca el campo password", function() {
    expect(res.body.detalle.password).to.exist;
  });
}
