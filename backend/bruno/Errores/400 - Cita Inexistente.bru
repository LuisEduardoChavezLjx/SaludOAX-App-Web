meta {
  name: 400 - Cita Inexistente
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/citas/999999
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenAdmin}}
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("mensaje de error de negocio", function() {
    expect(res.body.mensaje).to.equal("Cita no encontrada");
  });
}
