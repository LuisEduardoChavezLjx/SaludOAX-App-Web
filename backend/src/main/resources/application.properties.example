spring.application.name=saludoax
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/saludoax?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Mexico_City
spring.datasource.username=CAMBIA_ESTE_USUARIO
spring.datasource.password=CAMBIA_ESTA_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
# spring.jpa.show-sql=true

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

jwt.secret=CAMBIA_ESTE_SECRETO
jwt.expiration-ms=1800000

app.ia.api-key=CAMBIA_ESTA_KEY
app.ia.api-url=CAMBIA_ESTA_URL
app.ia.model=llama-3.3-70b-versatile

spring.mail.host=localhost
spring.mail.port=25

twilio.account-sid=CAMBIA_ESTE_SID
twilio.auth-token=CAMBIA_ESTE_TOKEN
twilio.whatsapp-from=CAMBIA_ESTE_NUMERO
twilio.sms-from=CAMBIA_ESTE_NUMERO
